PORT=3000
BASE_URL=https://telegram-oidc-provider.example.com
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# 16-256 chars of A-Z a-z 0-9 _ -  (e.g. `openssl rand -hex 32`)
TELEGRAM_WEBHOOK_SECRET=
DB_PATH=./data.db
KEYS_DIR=./keys
# Behind Caddy/Nginx, so rate limits see client IPs
TRUST_PROXY=true
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# REEVALUATE_POLICY_ON_REFRESH=true
# ISSUE_REFRESH_TOKENS=offline_access
# REFRESH_REUSE_GRACE=0
