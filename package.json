{
  "name": "telegram-oidc-provider",
  "version": "0.2.0",
  "description": "Self-hosted OAuth 2.0 / OpenID Connect identity provider that authenticates users with Telegram",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "register-client": "node --disable-warning=ExperimentalWarning scripts/register-client.js",
    "keys": "node --disable-warning=ExperimentalWarning scripts/keys.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "grammy": "^1.30.0",
    "jose": "^5.9.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
